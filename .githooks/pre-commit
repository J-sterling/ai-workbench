#!/usr/bin/env bash
# Blocks a commit that contains a secret or breaks the offline tests.
# Install once per clone: scripts/install-hooks.sh
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if command -v gitleaks >/dev/null; then
  gitleaks git --staged --redact --no-banner --config .gitleaks.toml . || {
    echo "pre-commit: gitleaks found a possible secret in the staged changes. Remove it before committing." >&2
    exit 1
  }
else
  echo "pre-commit: gitleaks not installed, skipping the secret scan (brew install gitleaks)." >&2
fi

uv run pytest -q || { echo "pre-commit: tests failed." >&2; exit 1; }
