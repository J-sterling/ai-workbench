# Copy to .env and fill in. .env is gitignored.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_SMART=nvidia/nemotron-3-super-120b-a12b
MODEL_FAST=nvidia/nemotron-3-super-120b-a12b
DATABASE_URL=postgresql://workbench:workbench@localhost:5432/workbench
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024

# Public demo guards (all optional locally)
# DEMO_PASSWORD=            # set it to require a password (any username) on everything except /health
# DAILY_RUN_LIMIT=200       # model-calling requests per UTC day, across all visitors
# MAX_LOG_BYTES=20000

# Token usage page: optional prices in USD per 1M tokens, from your Token Factory console
# PRICES='{"nvidia/nemotron-3-super-120b-a12b": [input, output], "Qwen/Qwen3-Embedding-8B": [input]}'
# USAGE_FILE=var/usage.jsonl

# Web search (Tavily): the agent checks live advisories and searches when no runbook matches.
# Leave empty to turn web search off. Locally: scripts/key-from-vault.sh tavily TAVILY_API_KEY
TAVILY_API_KEY=
# WEB_SEARCH_DAILY_LIMIT=25
